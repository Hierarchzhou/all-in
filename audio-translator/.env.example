# Audio Translator - 环境变量配置示例
# 复制此文件为 .env 并填入你的真实 API 密钥

# ============================================
# 必需的 API 密钥
# ============================================

# Claude API (用于文本翻译)
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# OpenAI API (用于 Whisper 语音识别)
OPENAI_API_KEY=sk-your-openai-key-here

# ============================================
# 可选的 API 密钥
# ============================================

# ElevenLabs API (用于高质量声音克隆)
# 免费额度: 10,000 字符/月
ELEVENLABS_API_KEY=your-elevenlabs-key-here

# ============================================
# 自定义 API 端点（可选）
# ============================================

# 自定义 Claude API 地址
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# HuggingFace 镜像（加速模型下载）
HF_ENDPOINT=https://hf-mirror.com

# ============================================
# IndexTTS 配置
# ============================================

# IndexTTS 模型路径（相对于项目根目录）
INDEXTTS_MODEL_DIR=models/indextts/checkpoints

# IndexTTS 设备选择 (cuda 或 cpu)
INDEXTTS_DEVICE=cuda

# 是否使用 FP16 半精度（节省显存）
INDEXTTS_USE_FP16=true

# ============================================
# 其他配置
# ============================================

# 默认 TTS 引擎 (edge/openai/elevenlabs/indextts)
DEFAULT_TTS_ENGINE=indextts

# 输出目录
OUTPUT_DIR=outputs

# 临时文件目录
TEMP_DIR=temp
